# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.wrmtwnk.mongodb.net/
DATABASE_NAME=sevenunique_ai_db

# Security & Authentication
JWT_SECRET=your-jwt-secret-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here
TOKEN_ENCRYPTION_KEY=your-token-encryption-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=1825

# Environment & Server
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI & Models
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-pro
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
VOICE_PROVIDER=gtts
VIDEO_PROVIDER=mock
# VIDEO_API_KEY=your_video_api_key_here

# Groq LLM (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Fashion AI
FASHION_IMAGE_PROVIDER=gemini
FASHION_IMAGE_API_KEY=your_fashion_api_key_here
VIRTUAL_TRYON_PROVIDER=gemini
VIRTUAL_TRYON_API_KEY=your_tryon_api_key_here

# Facebook & Instagram OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_API_VERSION=v19.0
FACEBOOK_SCOPES=public_profile,email,pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/facebook/callback

INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/login/user

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/login/user
LINKEDIN_SCOPES=openid profile email w_member_social

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# SMS / MSG91 OTP Configuration
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID_N_REG=your_new_registration_template_id
MSG91_TEMPLATE_ID_FOR_LOG=your_login_template_id
MSG91_TEMPLATE_ID_FOR_FORGET_PASWORD=your_forgot_password_template_id
MSG91_TEMPLATE_ID_FOR_RESET_MPIN=your_reset_mpin_template_id

# Payment Gateway (Finunique Payin)
PAYIN_URL=https://server.finuniques.in/api/v1/payment/payin
PAYIN_TOKEN=your_payin_token_here

# Geoapify Location API
GEOAPIFY_API_KEY=your_geoapify_key_here

# MSG91 WhatsApp OTP Configuration
MSG91_WHATSAPP_AUTHKEY=

# Fast2SMS OTP Configuration
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_SENDER_ID=DGROW
FAST2SMS_DLT_MESSAGE_ID=229008
FAST2SMS_ROUTE=dlt
FAST2SMS_VARIABLES_FORMAT={otp}|10

